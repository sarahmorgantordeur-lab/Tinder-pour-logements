// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//--------------------------------

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String
  username            String
  role                Role     @default(user)
  phone               String?
  avatar              String?

  // Préférences de notification
  email_notifications Boolean  @default(true)
  is_banned           Boolean  @default(false)

  // Propriétaire / agence
  company_name        String?
  siret               String?

  // Relations
  profile            Profile?
  pictures           Picture[]
  favorites          Favorite[]
  viewed_apartments  ViewedApartment[]
  swipes             Swipe[]
  matches            Match[]
  requests           Request[]
  messages           Message[]
  owned_apartments   Apartment[] @relation("UserApartments")

  preferences        Preferences?

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

enum Role {
  user
  owner
  agency
  admin
}

// Profil locataire — income visible uniquement via les filtres de recherche, pas exposé au propriétaire
model Profile {
  id                 String   @id @default(uuid())
  bio                String?
  job                String?
  income             Float?   // non exposé au propriétaire, utilisé côté recherche uniquement
  guarantors         Int?

  // Identité
  first_name         String?
  last_name          String?
  gender             Gender?

  // Composition du ménage
  household_size     Int?     // nombre de personnes
  has_pets           Boolean  @default(false)

  user               User     @relation(fields: [user_id], references: [id])
  user_id            String   @unique
}

enum Gender {
  male
  female
  non_binary
  prefer_not_to_say
}

model Picture {
  id                 String       @id @default(uuid())
  url                String
  type               PictureType
  uploaded_at        DateTime     @default(now())

  // Relation avec User (pour les photos de profil)
  user               User?        @relation(fields: [user_id], references: [id])
  user_id            String?

  // Relation avec Apartment (pour les photos d'appartement)
  apartment          Apartment?   @relation(fields: [apartment_id], references: [id])
  apartment_id       String?
}

enum PictureType {
  profile
  apartment
}

model Favorite {
  id                String     @id @default(uuid())
  user              User       @relation(fields: [user_id], references: [id])
  user_id           String
  apartment         Apartment  @relation(fields: [apartment_id], references: [id])
  apartment_id      String

  @@unique([user_id, apartment_id])
}

model ViewedApartment {
  id                String     @id @default(uuid())
  viewed_at         DateTime   @default(now())

  user              User       @relation(fields: [user_id], references: [id])
  user_id           String
  apartment         Apartment  @relation(fields: [apartment_id], references: [id])
  apartment_id      String
}

// Préférences de recherche locataire
model Preferences {
  id                String         @id @default(uuid())
  property_type     PropertyType[]
  listing_type      ListingType?
  min_price         Float?
  max_price         Float?
  min_surface       Float?
  max_surface       Float?
  has_terrace       Boolean?       // null = peu importe
  has_garden        Boolean?       // null = peu importe
  regions           String[]
  tags              String[]

  user              User           @relation(fields: [user_id], references: [id])
  user_id           String         @unique
}

//-----------------------------

model Apartment {
  id                String        @id @default(uuid())
  title             String
  description       String?
  address           String
  region            String
  city              String?
  postal_code       String?
  country           String        @default("Belgique")

  // Géolocalisation
  latitude          Float?
  longitude         Float?

  property_type     PropertyType  @default(appartement)
  listing_type      ListingType   @default(rent)
  price             Float
  surface           Float
  rooms             Int
  has_terrace       Boolean       @default(false)
  has_garden        Boolean       @default(false)
  tags              String[]
  availability      Boolean       @default(true)

  owner             User          @relation(fields: [owner_id], references: [id], name: "UserApartments")
  owner_id          String

  pictures          Picture[]
  favorites         Favorite[]
  viewedBy          ViewedApartment[]
  swipes            Swipe[]
  matches           Match[]
  requests          Request[]

  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  @@index([region])
  @@index([price])
  @@index([listing_type])
  @@index([property_type])
  @@index([surface])
  @@index([latitude, longitude])
}

enum PropertyType {
  // Maisons individuelles
  bungalow
  chalet
  chateau
  ferme
  maison_campagne
  maison_bel_etage
  maison_maitre
  manoir
  pavillon
  villa
  // Appartements et dérivés
  appartement
  duplex
  triplex
  studio
  penthouse
  loft
  kot
  appartement_service
  rez_de_chaussee
  // Immeubles
  immeuble_appartements
  immeuble_mixte
  // Autres
  bien_exceptionnel
  autres
}

enum ListingType {
  rent
  sale
}

//-----------------------------
// Request pour candidature informelle après le swipe

model Request {
  id                String        @id @default(uuid())

  apartment         Apartment     @relation(fields: [apartment_id], references: [id])
  apartment_id      String

  user              User          @relation(fields: [user_id], references: [id])
  user_id           String

  status            RequestStatus @default(waiting)
  message           String?

  documents         RequestDocument[]

  visit_date        DateTime?

  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  @@unique([apartment_id, user_id])
  @@index([user_id])
  @@index([apartment_id])
}

enum RequestStatus {
  waiting
  contacted
  visit_planned
  accepted
  refused
}

//----------------------------

model Swipe {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [user_id], references: [id])
  user_id          String
  apartment        Apartment @relation(fields: [apartment_id], references: [id])
  apartment_id     String
  direction        SwipeDirection
  created_at       DateTime @default(now())

  @@unique([user_id, apartment_id])
  @@index([user_id])
  @@index([apartment_id])
}

enum SwipeDirection {
  like
  dislike
}

//-------------------------------

model Match {
  id              String     @id @default(uuid())
  user            User       @relation(fields: [user_id], references: [id])
  user_id         String
  apartment       Apartment  @relation(fields: [apartment_id], references: [id])
  apartment_id    String
  messages        Message[]
  created_at      DateTime   @default(now())

  @@unique([user_id, apartment_id])
  @@index([user_id])
  @@index([apartment_id])
}

//------------------------------

model Message {
  id               String   @id @default(uuid())
  content          String
  match            Match    @relation(fields: [match_id], references: [id])
  match_id         String
  sender           User     @relation(fields: [sender_id], references: [id])
  sender_id        String
  created_at       DateTime @default(now())
}

//------------------------------

model RequestDocument {
  id               String   @id @default(uuid())
  name             String
  url              String
  uploaded_at      DateTime @default(now())

  request          Request  @relation(fields: [request_id], references: [id])
  request_id       String
}
