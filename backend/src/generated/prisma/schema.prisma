// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// UTILISATEUR
// ─────────────────────────────────────────────

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  firstname String
  lastname  String
  phone     String?
  avatar    String?
  bio       String?
  role      Role    @default(user)
  is_active Boolean @default(true)

  // Relations
  agency                  Agency?
  tenant_profile          TenantProfile?
  properties              Property[]     @relation("UserProperties")
  swipes                  Swipe[]
  conversations_as_tenant Conversation[] @relation("TenantConversations")
  conversations_as_owner  Conversation[] @relation("OwnerConversations")
  messages                Message[]
  profile_photos          ProfilePhoto[]
  documents               Document[]
  address                 Address        @relation(fields: [address_id], references: [id], onDelete: Cascade)
  address_id              String

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

enum Role {
  user
  owner
  agency
}

// ─────────────────────────────────────────────
// AGENCE
// ─────────────────────────────────────────────

model Agency {
  id         String  @id @default(uuid())
  nom_agence String
  numero_tva String?
  numero_bce String?
  site_web   String?

  address    Address @relation(fields: [address_id], references: [id], onDelete: Cascade)
  address_id String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @unique

  created_at DateTime @default(now())
}

// ─────────────────────────────────────────────
// PROFIL LOCATAIRE
// ─────────────────────────────────────────────

model TenantProfile {
  id             String         @id @default(uuid())
  household_size Int?
  budget_max     Float?
  min_surface    Int?
  max_surface    Int?
  regions        String[]
  property_types PropertyType[]

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ─────────────────────────────────────────────
// BIEN IMMOBILIER
// ─────────────────────────────────────────────

model Property {
  id            String         @id @default(uuid())
  title         String
  description   String?
  property_type PropertyType
  status        PropertyStatus @default(draft)

  address    Address @relation(fields: [address_id], references: [id], onDelete: Cascade)
  address_id String

  price   Int
  surface Int
  rooms   Int
  parking Boolean @default(false)

  owner    User   @relation(fields: [owner_id], references: [id], name: "UserProperties", onDelete: Cascade)
  owner_id String

  photos        AnnouncementPhoto[]
  swipes        Swipe[]
  conversations Conversation[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@index([price])
  @@index([surface])
  @@index([property_type])
  @@index([status])
}

enum PropertyType {
  Bungalow
  Chalet
  Castel
  Farm
  CountryHouse
  ApartmentBuilding
  MixedUseBuilding
  BelEtageHouse
  Mansion
  Villa
  ManorHouse
  Pavilion
  GroundFloor
  Duplex
  Triplex
  Studio
  Penthouse
  Loft
  StudentHousing
  ServiceApartment
  Appartement
  Other
}

enum PropertyStatus {
  draft
  published
  rented
  archived
}

// Photos d'une annonce
model AnnouncementPhoto {
  id    String @id @default(uuid())
  url   String
  order Int    @default(0)

  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  property_id String

  uploaded_at DateTime @default(now())
}

// Photos de profil utilisateur
model ProfilePhoto {
  id  String @id @default(uuid())
  url String

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  uploaded_at DateTime @default(now())
}

// Documents locataire (justificatifs, bulletins de salaire…)
model Document {
  id    String  @id @default(uuid())
  url   String
  label String?

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String

  uploaded_at DateTime @default(now())
}

// ─────────────────────────────────────────────
// SWIPE
// ─────────────────────────────────────────────

model Swipe {
  id        String  @id @default(uuid())
  direction Boolean

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     String
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  property_id String

  conversation Conversation?

  created_at DateTime @default(now())

  @@unique([user_id, property_id])
  @@index([user_id])
  @@index([property_id])
}

// ─────────────────────────────────────────────
// CONVERSATION
// ─────────────────────────────────────────────

model Conversation {
  id String @id @default(uuid())

  swipe    Swipe  @relation(fields: [swipe_id], references: [id], onDelete: Cascade)
  swipe_id String @unique

  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  property_id String

  tenant    User   @relation(fields: [tenant_id], references: [id], name: "TenantConversations", onDelete: Cascade)
  tenant_id String
  owner     User   @relation(fields: [owner_id], references: [id], name: "OwnerConversations", onDelete: Cascade)
  owner_id  String

  messages Message[]

  created_at DateTime @default(now())
}

// ─────────────────────────────────────────────
// MESSAGE
// ─────────────────────────────────────────────

model Message {
  id      String  @id @default(uuid())
  content String
  read    Boolean @default(false)

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  conversation_id String

  sender    User   @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  sender_id String

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@index([conversation_id])
  @@index([deleted_at])
}

// ─────────────────────────────────────────────
// ADDRESS
// ─────────────────────────────────────────────

model Address {
  id          String  @id @default(uuid())
  number      String
  box         String?
  street      String
  city        String
  postal_code String
  country     String

  users      User[]
  agencies   Agency[]
  properties Property[]

  created_at DateTime @default(now())

  @@index([city])
}
