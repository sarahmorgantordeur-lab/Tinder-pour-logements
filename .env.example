# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/findmyroof?schema=public"

# JWT Configuration - IMPORTANT: Generate a secure secret for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_secure_jwt_secret_minimum_32_characters"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Server Configuration
PORT=3000

# CORS Configuration (optional - defaults to * in development)
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (SMTP)
# Pour Gmail: host=smtp.gmail.com, port=587, utiliser un "App Password"
# Pour Mailtrap (test): host=sandbox.smtp.mailtrap.io
# Pour SendGrid: host=smtp.sendgrid.net, port=587
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM_NAME="FindMyRoof"
EMAIL_FROM_ADDRESS="noreply@findmyroof.com"

# Frontend URL (pour les liens dans les emails)
FRONTEND_URL="http://localhost:5173"
