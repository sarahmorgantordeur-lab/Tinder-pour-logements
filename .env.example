# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/findmyroof?schema=public"

# JWT Configuration - IMPORTANT: Generate a secure secret for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_secure_jwt_secret_minimum_32_characters"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Server Configuration
PORT=3000

# CORS Configuration (optional - defaults to * in development)
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
