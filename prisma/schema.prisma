// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//--------------------------------

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  username           String
  role               Role     @default(user)
  phone              String?
  avatar             String?

  // Propriétaire / agence
  company_name       String?
  siret              String?

  // Relations
  profile            Profile?
  documents          Document[]
  favorites          Favorite[]
  viewed_apartments  ViewedApartment[]
  swipes             Swipe[]
  matches            Match[]
  requests           Request[]
  messages           Message[]
  owned_apartments   Apartment[] @relation("UserApartments")

  preferences        Preferences?

  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

enum Role {
  user
  owner
  agency
}

model Profile {
  id                 String  @id @default(uuid())
  bio                String?
  job                String?
  income             Float?
  guarantors         Int?

  user               User    @relation(fields: [user_id], references: [id])
  user_id            String  @unique
}

model Document {
  id                 String       @id @default(uuid())
  name               String
  url                String
  type               DocumentType
  uploaded_at        DateTime     @default(now())

  user               User         @relation(fields: [user_id], references: [id])
  user_id            String
}

enum DocumentType {
  identity
  income
  guarantee
  other
}

model Favorite {
  id                String     @id @default(uuid())
  user              User       @relation(fields: [user_id], references: [id])
  user_id           String
  apartment         Apartment  @relation(fields: [apartment_id], references: [id])
  apartment_id      String

  @@unique([user_id, apartment_id])
}

model ViewedApartment {
  id                String     @id @default(uuid())
  viewed_at         DateTime   @default(now())

  user              User       @relation(fields: [user_id], references: [id])
  user_id           String
  apartment         Apartment  @relation(fields: [apartment_id], references: [id])
  apartment_id      String
}

model Preferences {
  id                String   @id @default(uuid())
  property_type     String[]
  listing_type      String?
  min_price         Float?
  max_price         Float?
  min_surface       Float?
  regions           String[]
  tags              String[]

  user              User     @relation(fields: [user_id], references: [id])
  user_id           String   @unique
}

//-----------------------------

model Apartment {
  id                String        @id @default(uuid())
  title             String
  description       String?
  address           String
  region            String
  property_type     PropertyType  @default(apartment)
  listing_type      ListingType   @default(rent)
  price             Float
  surface           Float
  rooms             Int
  pictures          String[]
  tags              String[]
  availability      Boolean @default(true)

  owner             User          @relation(fields: [owner_id], references: [id], name: "UserApartments")
  owner_id          String

  favorites         Favorite[]
  viewedBy          ViewedApartment[]
  swipes            Swipe[]
  matches           Match[]
  requests          Request[]

  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  @@index([region])
  @@index([price])
  @@index([listing_type])
  @@index([property_type])
  @@index([surface])
}

enum PropertyType {
  apartment
  house
  studio
  villa
  land
  commercial_space
  other
}

enum ListingType {
  rent
  sale
}

//-----------------------------
// Request pour candidature informelle après le swipe

model Request {
  id                String        @id @default(uuid())

  apartment         Apartment     @relation(fields: [apartment_id], references: [id])
  apartment_id      String

  user              User          @relation(fields: [user_id], references: [id])
  user_id           String

  status            RequestStatus @default(waiting)
  message           String?

  documents         RequestDocument[]

  visit_date        DateTime?

  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  @@unique([apartment_id, user_id])
  @@index([user_id])
  @@index([apartment_id])
}

enum RequestStatus {
  waiting
  contacted
  visit_planned
  accepted
  refused
}

//----------------------------

model Swipe {
  id               String   @id @default(uuid())
  user             User     @relation(fields: [user_id], references: [id])
  user_id          String
  apartment        Apartment @relation(fields: [apartment_id], references: [id])
  apartment_id     String
  direction        SwipeDirection
  created_at       DateTime @default(now())

  @@unique([user_id, apartment_id])
  @@index([user_id])
  @@index([apartment_id])
}

enum SwipeDirection {
  like
  dislike
}

//-------------------------------

model Match {
  id              String     @id @default(uuid())
  user            User       @relation(fields: [user_id], references: [id])
  user_id         String
  apartment       Apartment  @relation(fields: [apartment_id], references: [id])
  apartment_id    String
  messages        Message[]
  created_at      DateTime   @default(now())

  @@unique([user_id, apartment_id])
  @@index([user_id])
  @@index([apartment_id])
}

//------------------------------

model Message {
  id               String   @id @default(uuid())
  content          String
  match            Match    @relation(fields: [match_id], references: [id])
  match_id         String
  sender           User     @relation(fields: [sender_id], references: [id])
  sender_id        String
  created_at       DateTime @default(now())
}

//------------------------------

model RequestDocument {
  id               String   @id @default(uuid())
  name             String
  url              String
  uploaded_at      DateTime @default(now())

  request          Request  @relation(fields: [request_id], references: [id])
  request_id       String
}

